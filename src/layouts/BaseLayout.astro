---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-700.css';
import Icon from '../components/Icon.astro';
import Monogram from '../components/Monogram.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { SITE } from '../lib/posts';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: 'en' | 'ar';
  type?: 'website' | 'article';
}

const { title, description = SITE.description, ogImage, lang = 'en', type = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href)
  : undefined;
const siteTitle = SITE.author;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home', active: path === '/' },
  { href: '/blog', label: 'Articles', active: path.startsWith('/blog') },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title === siteTitle ? title : `${title} — ${siteTitle}`}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteTitle} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1219" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} — RSS`} href="/rss.xml" />
    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved ?? (prefersDark ? 'dark' : 'light'));
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label={`${siteTitle} — home`}>
          <span class="brand-mark"><Monogram /></span>
          <span class="brand-text">
            <span class="brand-name">{siteTitle}</span>
            <span class="brand-tag">Blog · Writing · Ideas</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} class:list={['nav-link', { active: item.active }]} aria-current={item.active ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="header-actions">
          <button type="button" class="search-trigger" data-search-open aria-label="Search articles">
            <Icon name="search" size={16} />
            <span class="search-trigger-label">Search</span>
            <kbd class="search-trigger-kbd"><span data-mod-key>⌘</span>K</kbd>
          </button>
          <button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label="Toggle light/dark theme">
            <Icon name="moon" class="icon-moon" />
            <Icon name="sun" class="icon-sun" />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="brand" aria-label={`${siteTitle} — home`}>
              <span class="brand-mark"><Monogram /></span>
              <span class="brand-text">
                <span class="brand-name">{siteTitle}</span>
                <span class="brand-tag">Blog · Writing · Ideas</span>
              </span>
            </a>
            <p class="footer-bio">
              Essays on software architecture, distributed systems, and the human side of building software.
            </p>
          </div>

          <div class="footer-col">
            <p class="footer-heading">Explore</p>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/blog">All articles</a></li>
              <li><button type="button" class="footer-link-btn" data-search-open>Search</button></li>
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <p class="footer-heading">Connect</p>
            <ul>
              <li><a href={SITE.links.website} target="_blank" rel="noopener noreferrer">msweelam.dev</a></li>
              <li><a href={SITE.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
              <li><a href={SITE.links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p>© {year} {siteTitle}. All rights reserved.</p>
          <div class="footer-social">
            <a href={SITE.links.website} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Personal website"><Icon name="globe" size={17} /></a>
            <a href={SITE.links.linkedin} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="LinkedIn"><Icon name="linkedin" size={16} /></a>
            <a href={SITE.links.github} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="GitHub"><Icon name="github" size={16} /></a>
            <a href="/rss.xml" class="icon-btn" aria-label="RSS feed"><Icon name="rss" size={17} /></a>
          </div>
        </div>
      </div>
    </footer>

    <SearchPalette />

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        const apply = function () {
          root.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
        };
        // Reveal the new theme as a circle growing from the toggle (View Transitions API, where available).
        if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const rect = this.getBoundingClientRect();
          root.style.setProperty('--reveal-x', rect.left + rect.width / 2 + 'px');
          root.style.setProperty('--reveal-y', rect.top + rect.height / 2 + 'px');
          root.classList.add('theme-transition');
          document.startViewTransition(apply).finished.finally(function () {
            root.classList.remove('theme-transition');
          });
        } else {
          apply();
        }
      });

      // Elevate the header once the page scrolls.
      (function () {
        const header = document.querySelector('.site-header');
        const onScroll = function () { header.classList.toggle('is-scrolled', window.scrollY > 8); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
