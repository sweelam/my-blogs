---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Monogram from '../components/Monogram.astro';
import PostActions from '../components/PostActions.astro';
import PostViews from '../components/PostViews.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE, formatDate, readingLabel } from '../lib/posts';

interface PostLink { href: string; title: string; lang: 'en' | 'ar' }

interface Props {
  slug: string;
  title: string;
  date: Date;
  description?: string;
  showLede?: boolean;
  cover?: string;
  tags?: string[];
  lang?: 'en' | 'ar';
  headings?: MarkdownHeading[];
  minutes: number;
  newer?: PostLink;
  older?: PostLink;
}

const {
  slug, title, date, description, showLede = false, cover, tags, lang = 'en',
  headings = [], minutes, newer, older,
} = Astro.props;

const t = {
  en: {
    back: 'All articles',
    toc: 'On this page',
    newer: 'Newer article',
    older: 'Previous article',
    writtenBy: 'Written by',
    bio: 'Software engineer writing about distributed systems, architecture, programming languages, and the human side of engineering.',
    top: 'Back to top',
  },
  ar: {
    back: 'كل المقالات',
    toc: 'محتويات المقال',
    newer: 'المقال الأحدث',
    older: 'المقال السابق',
    writtenBy: 'بقلم',
    bio: 'مهندس برمجيات يكتب عن الأنظمة الموزعة وهندسة البرمجيات ولغات البرمجة والجانب الإنساني في الهندسة.',
    top: 'العودة للأعلى',
  },
}[lang];
---

<BaseLayout title={title} description={description} ogImage={cover} lang={lang} type="article">
  <div class="reading-progress" aria-hidden="true"><span></span></div>

  <article class="article">
    <header class="container article-header">
      <div class="article-head">
        <a href="/blog" class="back-link">
          <Icon name="arrow-left" size={16} class="flip-rtl" /> {t.back}
        </a>

        <div class="article-meta">
          <time datetime={date.toISOString()}>{formatDate(date, lang, 'long')}</time>
          <span class="dot" aria-hidden="true"></span>
          <span class="meta-item"><Icon name="clock" size={15} />{readingLabel(minutes, lang)}</span>
          <PostViews slug={slug} lang={lang} />
        </div>

        <h1 class="article-title">{title}</h1>
        {showLede && <p class="article-lede">{description}</p>}

        {tags && tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}

        <div class="byline">
          <span class="byline-mark"><Monogram /></span>
          <span class="byline-text">
            <span class="byline-label">{t.writtenBy}</span>
            <a href={SITE.links.website} target="_blank" rel="noopener noreferrer" class="byline-name">{SITE.author}</a>
          </span>
        </div>
      </div>

      {cover && (
        <figure class="article-cover" style={`view-transition-name: cover-${slug}`}>
          <img src={cover} alt={title} loading="eager" fetchpriority="high" />
        </figure>
      )}
    </header>

    <div class="container article-layout">
      <div class="article-main">
        <div class="article-body" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
          <slot />
        </div>

        <PostActions slug={slug} title={title} lang={lang} />

        <aside class="author-card" aria-label={t.writtenBy}>
          <span class="author-mark"><Monogram /></span>
          <div class="author-info">
            <p class="author-label">{t.writtenBy}</p>
            <p class="author-name">{SITE.author}</p>
            <p class="author-bio">{t.bio}</p>
            <div class="author-links">
              <a href={SITE.links.website} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Personal website"><Icon name="globe" size={17} /></a>
              <a href={SITE.links.linkedin} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="LinkedIn"><Icon name="linkedin" size={16} /></a>
              <a href={SITE.links.github} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="GitHub"><Icon name="github" size={16} /></a>
            </div>
          </div>
        </aside>
      </div>

      <aside class="article-aside">
        <TableOfContents headings={headings} label={t.toc} />
      </aside>
    </div>

    {(newer || older) && (
      <nav class="container post-nav" aria-label={lang === 'ar' ? 'تصفح المقالات' : 'More articles'}>
        {older ? (
          <a href={older.href} class="post-nav-link post-nav-link--prev">
            <span class="post-nav-label"><Icon name="arrow-left" size={15} class="flip-rtl" />{t.older}</span>
            <span class="post-nav-title" lang={older.lang} dir={older.lang === 'ar' ? 'rtl' : 'ltr'}>{older.title}</span>
          </a>
        ) : <span />}
        {newer && (
          <a href={newer.href} class="post-nav-link post-nav-link--next">
            <span class="post-nav-label">{t.newer}<Icon name="arrow-right" size={15} class="flip-rtl" /></span>
            <span class="post-nav-title" lang={newer.lang} dir={newer.lang === 'ar' ? 'rtl' : 'ltr'}>{newer.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>

  <button type="button" class="back-to-top" aria-label={t.top} hidden>
    <Icon name="arrow-up" size={18} />
  </button>

  <dialog class="image-lightbox" id="image-lightbox" aria-label="Image preview">
    <button type="button" class="image-lightbox-close" aria-label="Close preview">×</button>
    <figure class="image-lightbox-content">
      <img class="image-lightbox-img" alt="" />
      <figcaption class="image-lightbox-caption"></figcaption>
    </figure>
  </dialog>
</BaseLayout>

<script>
  // ── Image lightbox ──────────────────────────────────────────────────────────
  const lightbox = document.getElementById('image-lightbox') as HTMLDialogElement;
  const lightboxImg = lightbox.querySelector('.image-lightbox-img') as HTMLImageElement;
  const caption = lightbox.querySelector('.image-lightbox-caption') as HTMLElement;
  const closeBtn = lightbox.querySelector('.image-lightbox-close') as HTMLButtonElement;

  function openLightbox(img: HTMLImageElement) {
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    caption.textContent = img.alt;
    caption.hidden = !img.alt;
    lightbox.showModal();
  }

  document.querySelectorAll('.article-body img, .article-cover img').forEach((el) => {
    const img = el as HTMLImageElement;
    img.classList.add('article-image-zoomable');
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', img.alt ? `View larger: ${img.alt}` : 'View larger image');

    img.addEventListener('click', () => openLightbox(img));
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(img);
      }
    });
  });

  closeBtn.addEventListener('click', () => lightbox.close());
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });

  // ── Heading anchors ─────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.article-body :is(h2, h3, h4)[id]').forEach((h) => {
    const a = document.createElement('a');
    a.className = 'heading-anchor';
    a.href = `#${h.id}`;
    a.textContent = '#';
    a.setAttribute('aria-hidden', 'true');
    a.tabIndex = -1;
    h.append(a);
  });

  // ── Code blocks: language label + copy button ───────────────────────────────
  document.querySelectorAll<HTMLPreElement>('.article-body pre').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);

    const bar = document.createElement('div');
    bar.className = 'code-block-bar';
    const language = document.createElement('span');
    language.className = 'code-block-lang';
    const lang = pre.dataset.language;
    language.textContent = lang && lang !== 'plaintext' ? lang : 'text';

    const copy = document.createElement('button');
    copy.type = 'button';
    copy.className = 'code-block-copy';
    copy.textContent = 'Copy';
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        copy.textContent = 'Copied!';
        copy.classList.add('is-copied');
      } catch {
        copy.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => {
        copy.textContent = 'Copy';
        copy.classList.remove('is-copied');
      }, 1800);
    });

    bar.append(language, copy);
    wrapper.append(bar, pre);
  });

  // ── Reading progress + back-to-top ──────────────────────────────────────────
  const progress = document.querySelector<HTMLElement>('.reading-progress span')!;
  const body = document.querySelector<HTMLElement>('.article-body')!;
  const toTop = document.querySelector<HTMLButtonElement>('.back-to-top')!;

  let ticking = false;
  function onScroll() {
    const rect = body.getBoundingClientRect();
    const total = rect.height - window.innerHeight * 0.6;
    const ratio = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
    progress.style.transform = `scaleX(${ratio})`;
    toTop.hidden = window.scrollY < 900;
    ticking = false;
  }
  window.addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
  }, { passive: true });
  onScroll();

  toTop.addEventListener('click', () => {
    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
  });
</script>
