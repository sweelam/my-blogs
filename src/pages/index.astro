---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, getSortedPosts, readingTime } from '../lib/posts';

const all = await getSortedPosts();
const [featured, ...rest] = all;
const latest = rest.slice(0, 6);
const totalMinutes = all.reduce((sum, post) => sum + readingTime(post.body), 0);
const languages = new Set(all.map((post) => post.data.lang)).size;
---

<BaseLayout title={SITE.author} description={SITE.description}>
  <section class="hero">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Blog · Writing · Ideas</p>
        <h1 class="hero-title">
          Notes on <em>software architecture</em> and the craft of engineering.
        </h1>
        <p class="hero-lede">
          Hi, I'm {SITE.author}, a software engineer writing about distributed systems,
          architecture, programming languages, and the human side of engineering.
        </p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">
            Browse all articles <Icon name="arrow-right" size={16} />
          </a>
          <button type="button" class="btn btn-ghost" data-search-open>
            <Icon name="search" size={16} /> Search
            <kbd class="kbd-inline"><span data-mod-key>⌘</span>K</kbd>
          </button>
        </div>
        <dl class="hero-stats">
          <div><dt>Essays</dt><dd>{all.length}</dd></div>
          <div><dt>Minutes of reading</dt><dd>{totalMinutes}</dd></div>
          <div><dt>Languages</dt><dd>{languages > 1 ? 'EN · AR' : 'EN'}</dd></div>
        </dl>
      </div>

      {featured && (
        <div class="hero-feature">
          <p class="feature-label"><span class="pulse" aria-hidden="true"></span>Latest article</p>
          <PostCard post={featured} variant="featured" headingLevel="h2" eager />
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-kicker">From the journal</p>
          <h2 class="section-title">Recent writing</h2>
        </div>
        <a href="/blog" class="link-arrow">View all <Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="posts-grid">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2 class="cta-title">Enjoying the writing?</h2>
          <p class="cta-text">Follow along for new essays on architecture, engineering leadership, and building with AI.</p>
        </div>
        <div class="cta-actions">
          <a href="/rss.xml" class="btn btn-primary"><Icon name="rss" size={16} /> Subscribe via RSS</a>
          <a href={SITE.links.linkedin} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" size={15} /> Follow on LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
