---
import Icon from './Icon.astro';
import { formatDate, getSortedPosts, readingLabel, readingTime } from '../lib/posts';

const index = (await getSortedPosts()).map((post) => ({
  url: `/blog/${post.slug}`,
  title: post.data.title,
  description: post.data.description ?? '',
  lang: post.data.lang,
  meta: `${formatDate(post.data.date, post.data.lang)} · ${readingLabel(readingTime(post.body), post.data.lang)}`,
}));
// Escape `<` so the payload can never terminate the surrounding inline JSON script tag early.
const payload = JSON.stringify(index).replace(/</g, '\\u003c');
---

<dialog class="search" id="search-dialog" aria-label="Search articles">
  <div class="search-panel">
    <div class="search-field">
      <Icon name="search" size={20} />
      <input
        id="search-input"
        type="text"
        placeholder="Search articles…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button type="button" class="search-esc" data-search-close aria-label="Close search"><kbd>Esc</kbd></button>
    </div>
    <ul id="search-results" class="search-results" role="listbox" aria-label="Articles"></ul>
    <p class="search-empty" hidden>No articles match “<span></span>”.</p>
    <div class="search-footer" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
      <span><kbd>↵</kbd> to open</span>
      <span class="search-footer-count"></span>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" id="search-index" set:html={payload} />

<script>
  interface Entry { url: string; title: string; description: string; lang: string; meta: string }

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results') as HTMLUListElement;
  const empty = dialog.querySelector<HTMLElement>('.search-empty')!;
  const count = dialog.querySelector<HTMLElement>('.search-footer-count')!;
  const entries: Entry[] = JSON.parse(document.getElementById('search-index')!.textContent!);

  // Case-, accent- and Arabic-diacritic-insensitive comparison.
  const normalize = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f\u064b-\u065f\u0670]/g, '');
  const haystacks = entries.map((e) => ({ title: normalize(e.title), body: normalize(e.description) }));

  let results: Entry[] = entries;
  let active = 0;

  function highlight(text: string, terms: string[]): DocumentFragment {
    const frag = document.createDocumentFragment();
    if (!terms.length) {
      frag.append(text);
      return frag;
    }
    const escaped = terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
    text.split(new RegExp(`(${escaped.join('|')})`, 'gi')).forEach((part, i) => {
      if (i % 2) {
        const mark = document.createElement('mark');
        mark.textContent = part;
        frag.append(mark);
      } else if (part) {
        frag.append(part);
      }
    });
    return frag;
  }

  function search(query: string) {
    const terms = normalize(query).split(/\s+/).filter(Boolean);
    if (!terms.length) return entries;
    return entries
      .map((entry, i) => {
        const { title, body } = haystacks[i];
        if (!terms.every((t) => title.includes(t) || body.includes(t))) return null;
        const score = terms.reduce((sum, t) => sum + (title.includes(t) ? 3 : 1), 0);
        return { entry, score };
      })
      .filter((r): r is { entry: Entry; score: number } => r !== null)
      .sort((a, b) => b.score - a.score)
      .map((r) => r.entry);
  }

  function setActive(next: number) {
    const items = list.querySelectorAll<HTMLElement>('[role="option"]');
    if (!items.length) return;
    active = (next + items.length) % items.length;
    items.forEach((el, i) => el.setAttribute('aria-selected', String(i === active)));
    input.setAttribute('aria-activedescendant', items[active].id);
    items[active].scrollIntoView({ block: 'nearest' });
  }

  function render() {
    const query = input.value.trim();
    const terms = query.split(/\s+/).filter(Boolean);
    results = search(query);
    list.replaceChildren(
      ...results.map((entry, i) => {
        const li = document.createElement('li');
        li.id = `search-option-${i}`;
        li.setAttribute('role', 'option');
        li.lang = entry.lang;
        li.dir = entry.lang === 'ar' ? 'rtl' : 'ltr';

        const a = document.createElement('a');
        a.href = entry.url;
        a.tabIndex = -1;
        const title = document.createElement('span');
        title.className = 'search-result-title';
        title.append(highlight(entry.title, terms));
        const desc = document.createElement('span');
        desc.className = 'search-result-desc';
        desc.append(highlight(entry.description, terms));
        const meta = document.createElement('span');
        meta.className = 'search-result-meta';
        meta.textContent = entry.meta;
        a.append(title, desc, meta);

        li.append(a);
        li.addEventListener('mousemove', () => active !== i && setActive(i));
        return li;
      }),
    );
    empty.hidden = results.length > 0;
    empty.querySelector('span')!.textContent = query;
    count.textContent = `${results.length} of ${entries.length} articles`;
    setActive(0);
  }

  function open() {
    if (dialog.open) return;
    input.value = '';
    render();
    dialog.showModal();
    input.focus();
  }

  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter' && results[active]) { e.preventDefault(); window.location.href = results[active].url; }
  });

  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
  document.querySelectorAll('[data-search-open]').forEach((btn) => btn.addEventListener('click', open));

  document.addEventListener('keydown', (e) => {
    const typing = e.target instanceof HTMLElement && e.target.closest('input, textarea, [contenteditable="true"]');
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });

  // Show the platform-appropriate shortcut hint.
  if (!/Mac|iPhone|iPad/.test(navigator.userAgent)) {
    document.querySelectorAll('[data-mod-key]').forEach((el) => (el.textContent = 'Ctrl'));
  }
</script>
