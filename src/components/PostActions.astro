---
interface Props {
  slug: string;
  title: string;
  lang?: 'en' | 'ar';
}

const { slug, title, lang = 'en' } = Astro.props;

const labels = {
  en: {
    prompt: 'Did you find this article useful?',
    like: 'Like',
    dislike: 'Dislike',
    share: 'Share',
    copy: 'Copy link',
    copied: 'Link copied',
  },
  ar: {
    prompt: 'هل وجدت هذا المقال مفيدًا؟',
    like: 'أعجبني',
    dislike: 'لم يعجبني',
    share: 'شارك',
    copy: 'نسخ الرابط',
    copied: 'تم نسخ الرابط',
  },
}[lang];

const url = new URL(Astro.url.pathname, Astro.site).href;
const linkedInHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
const xHref = `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
---

<section class="post-actions" dir={lang === 'ar' ? 'rtl' : 'ltr'} data-slug={slug}>
  <!-- Revealed by the script once the reactions API answers (it isn't available under `astro dev`). -->
  <div class="post-reactions" hidden>
    <span class="post-actions-label">{labels.prompt}</span>
    <div class="post-actions-buttons">
      <button type="button" class="post-action-btn" data-reaction="like" aria-pressed="false" aria-label={labels.like}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/>
        </svg>
        <span class="post-action-count" data-count="like">0</span>
      </button>
      <button type="button" class="post-action-btn" data-reaction="dislike" aria-pressed="false" aria-label={labels.dislike}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"/>
        </svg>
        <span class="post-action-count" data-count="dislike">0</span>
      </button>
    </div>
  </div>

  <div class="post-share">
    <span class="post-actions-label">{labels.share}</span>
    <div class="post-actions-buttons">
      <a class="post-action-btn" href={linkedInHref} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a class="post-action-btn" href={xHref} target="_blank" rel="noopener noreferrer" aria-label="X">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <button type="button" class="post-action-btn" data-copy={url} data-copied-label={labels.copied} aria-label={labels.copy} title={labels.copy}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
        <span class="post-action-toast" role="status"></span>
      </button>
    </div>
  </div>
</section>

<script>
  type Reaction = 'like' | 'dislike';
  interface Counts { likes: number; dislikes: number; mine: Reaction | null }

  const root = document.querySelector<HTMLElement>('.post-actions')!;
  const slug = root.dataset.slug!;
  const endpoint = `/api/reactions/${encodeURIComponent(slug)}`;
  const reactions = root.querySelector<HTMLElement>('.post-reactions')!;
  const buttons = reactions.querySelectorAll<HTMLButtonElement>('[data-reaction]');

  let state: Counts = { likes: 0, dislikes: 0, mine: null };

  function render(next: Counts) {
    state = next;
    reactions.querySelector('[data-count="like"]')!.textContent = String(next.likes);
    reactions.querySelector('[data-count="dislike"]')!.textContent = String(next.dislikes);
    buttons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.reaction === next.mine)));
  }

  function applyLocally(prev: Counts, mine: Reaction | null): Counts {
    const next = { ...prev, mine };
    if (prev.mine === 'like') next.likes -= 1;
    if (prev.mine === 'dislike') next.dislikes -= 1;
    if (mine === 'like') next.likes += 1;
    if (mine === 'dislike') next.dislikes += 1;
    return next;
  }

  async function load() {
    try {
      const res = await fetch(endpoint);
      if (!res.ok) return;
      render(await res.json());
      reactions.hidden = false;
    } catch {
      // API unavailable (e.g. `astro dev`): keep the reactions hidden.
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const clicked = btn.dataset.reaction as Reaction;
      const mine = state.mine === clicked ? null : clicked;
      const prev = state;

      render(applyLocally(prev, mine));
      buttons.forEach((b) => (b.disabled = true));
      try {
        const res = await fetch(endpoint, {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ reaction: mine }),
        });
        if (!res.ok) throw new Error(String(res.status));
        render(await res.json());
      } catch {
        render(prev);
      } finally {
        buttons.forEach((b) => (b.disabled = false));
      }
    });
  });

  const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]')!;
  const toast = copyBtn.querySelector<HTMLElement>('.post-action-toast')!;
  let toastTimer: number | undefined;
  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.copy!);
      toast.textContent = copyBtn.dataset.copiedLabel!;
      copyBtn.classList.add('is-copied');
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.textContent = '';
        copyBtn.classList.remove('is-copied');
      }, 2000);
    } catch {
      window.prompt('', copyBtn.dataset.copy!);
    }
  });

  load();
</script>
